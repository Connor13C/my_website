[DEFAULT]
bantime           = 2h
bantime.increment = true
bantime.maxtime   = 5w
bantime.factor    = 2
findtime          = 10m
maxretry          = 5
ignoreip          = 127.0.0.1/8 ::1
dbpurgeage        = 7d
action            = iptables-multiport[blocktype=DROP]

[nginx-bad-request]
enabled = true
chain   = DOCKER-USER

[nginx-forbidden]
enabled  = true
chain    = DOCKER-USER
maxretry = 3

[nginx-http-auth]
enabled = true
chain   = DOCKER-USER

[nginx-limit-req]
enabled  = true
chain    = DOCKER-USER
maxretry = 10

[nginx-unauthorized]
enabled  = true
chain    = DOCKER-USER
maxretry = 10

[recidive]
enabled  = true
chain    = DOCKER-USER
bantime  = 1w
findtime = 1d

[sshd]
enabled  = true
chain    = INPUT
maxretry = 3
bantime = 6h
