[DEFAULT]
bantime           = 2h
bantime.increment = true
bantime.maxtime   = 5w
bantime.factor    = 2
findtime          = 10m
maxretry          = 5
ignoreip          = 127.0.0.1/8 ::1
dbpurgeage        = 7d
action            = iptables-multiport[blocktype=DROP]

[nginx-http-auth]
# configuration inherits from jail.conf
enabled = true
chain   = DOCKER-USER
filter  = nginx-http-auth

[nginx-limit-req]
# configuration inherits from jail.d/nginx-limit-req.conf
enabled  = true
chain    = DOCKER-USER
filter   = nginx-limit-req
maxretry = 10

[recidive]
enabled  = true
chain    = DOCKER-USER
bantime  = 1w
findtime = 1d
maxretry = 5

[sshd]
# configuration inherits from jail.conf
enabled  = true
chain    = INPUT
filter   = sshd
maxretry = 3
bantime = 6h
