POSTGRES_PASSWORD=random_postgres_password
DEBUG=True
POSTGRES_ENGINE=postgresql+psycopg2
POSTGRES_USER=random_postgres_user
POSTGRES_HOST=db3
POSTGRES_PORT=5432
POSTGRES_DB=postgres
DATABASE_URL="${POSTGRES_ENGINE}://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"
REDIS_ENGINE=redis
REDIS_HOST=redis3
REDIS_PORT=6379
CELERY_BROKER_URL="${REDIS_ENGINE}://${REDIS_HOST}:${REDIS_PORT}"
CELERY_RESULT_BACKEND="${REDIS_ENGINE}://${REDIS_HOST}:${REDIS_PORT}"
